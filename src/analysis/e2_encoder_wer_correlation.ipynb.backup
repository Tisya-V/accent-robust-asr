   ],
   "source": [
    "# Data already aggregated in cell 5; verify structure\n",
    "print(f\"✓ Loaded L1-aggregated data for {len(prompt_l1_data)} prompts\")\n",
    "print(f\"Sample: {list(prompt_l1_data.keys())[:3]}\")\n",
    "for pid, l1_dict in list(prompt_l1_data.items())[:1]:\n",
    "    print(f\"  {pid}: L1s = {list(l1_dict.keys())}\")"
   ]
