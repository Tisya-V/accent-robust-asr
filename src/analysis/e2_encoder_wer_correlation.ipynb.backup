   "source": [
    "# Motivational Experiment for E2: Encoder-Space Deviation vs. WER Correlation\n",
    "\n",
    "Test whether encoder-space distance between canonical (CMU native English) and L2 speech predicts transcription error (WER).\n",
    "\n",
    "**Approach:** L1-level averaging (4 speakers per L1). Whisper zero-shot WER only (no fine-tuning confound).\n",
    "\n",
    "**Metric:** Cosine distance between L1-averaged encoder states (final layer), aggregated per utterance, correlated with L1-averaged Whisper WER."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Imports complete\n"
     ]
    }
   ],
   "source": [
    "import sys, os\n",
    "sys.path.insert(0, '/rds/general/user/tsv22/home/accent-robust-asr')\n",
    "\n",
    "import torch\n",
    "import pickle\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "from tqdm import tqdm\n",
    "from collections import defaultdict\n",
    "from concurrent.futures import ThreadPoolExecutor\n",
    "import re\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy.stats import pearsonr, spearmanr\n",
    "from sklearn.metrics.pairwise import cosine_distances\n",
    "\n",
    "from src.config import SPEAKER_L1, ENCODER_FRAME_RATE\n",
    "\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (10, 6)\n",
    "\n",
    "print(\"✓ Imports complete\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "EPHEMERAL = Path(os.environ.get('EPHEMERAL', 'data/processed'))\n",
    "ENCODER_STATES_DIR = EPHEMERAL / 'accent-robust-asr' / 'probing' / 'encoder_states'\n",
    "PHONE_SEGMENTS_DIR = EPHEMERAL / 'accent-robust-asr' / 'probing' / 'phone_segments'\n",
    "RESULTS_DIR = Path('src/analysis/results')\n",
    "L2ARCTIC_DIR = Path('data/l2_arctic')\n",
    "CMU_ARCTIC_DIR = Path('data/cmu_arctic')\n",
    "\n",
    "# Verify paths exist\n",
    "assert PHONE_SEGMENTS_DIR.exists(), f\"Phone segments dir not found: {PHONE_SEGMENTS_DIR}\"\n",
    "RESULTS_DIR.mkdir(parents=True, exist_ok=True)"
   ]
  },
