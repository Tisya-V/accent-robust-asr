   "source": [
    "import gc\n",
    "from concurrent.futures import ThreadPoolExecutor, as_completed\n",
    "\n",
    "print(\"Loading phone segments and computing L1 averages on-the-fly...\")\n",
    "cache_path = RESULTS_DIR / 'prompt_l1_data_aggregated.pkl'\n",
    "\n",
    "def process_speaker_dir_efficient(spk_dir):\n",
    "    \"\"\"\n",
    "    Load speaker's utterances, extract final layer only.\n",
    "    Memory-efficient: deletes intermediate arrays immediately.\n",
    "    \"\"\"\n",
    "    speaker = spk_dir.name\n",
    "    l1 = SPEAKER_L1.get(speaker, 'Unknown')\n",
    "    \n",
    "    # Accumulate per prompt\n",
    "    prompt_reps = {}  # prompt_id -> {'reps': [...], 'labels': [...]}\n",
    "    \n",
    "    for pkl_file in sorted(spk_dir.glob('*_phones.pkl')):\n",
    "        utt_id = pkl_file.stem.replace('_phones', '')\n",
    "        try:\n",
    "            with open(pkl_file, 'rb') as f:\n",
    "                data = pickle.load(f)\n",
    "            phone_reps = data.get('phone_reps', [])\n",
    "            if not phone_reps:\n",
    "                continue\n",
    "            \n",
    "            labels = [p['label'] for p in phone_reps]\n",
    "            # Extract ONLY final layer to save memory\n",
    "            reps_final = np.array([p['layer_reps'][11] for p in phone_reps])  # (n_phones, 768)\n",
    "            prompt_id = utt_id.split('_', 1)[1] if '_' in utt_id else utt_id\n",
    "            \n",
    "            if prompt_id not in prompt_reps:\n",
    "                prompt_reps[prompt_id] = {'reps': [], 'labels': labels}\n",
    "            prompt_reps[prompt_id]['reps'].append(reps_final)\n",
    "            \n",
    "            del data, phone_reps, reps_final\n",
    "        except Exception as e:\n",
    "            print(f\"Error processing {pkl_file} for speaker {speaker}: {e}\")\n",
    "            pass\n",
    "    \n",
    "    return speaker, l1, prompt_reps\n",
    "\n",
    "\n",
    "if cache_path.exists():\n",
    "    print(\"Loading from cache...\")\n",
    "    with open(cache_path, 'rb') as f:\n",
    "        prompt_l1_data = pickle.load(f)\n",
    "else:\n",
    "    print(\"No cache found, processing from scratch...\")\n",
    "    prompt_l1_data = defaultdict(dict)\n",
    "    \n",
    "    for split in ['train', 'dev', 'test']:\n",
    "        split_dir = PHONE_SEGMENTS_DIR / split\n",
    "        if not split_dir.exists():\n",
    "            continue\n",
    "        \n",
    "        print(f\"\\nProcessing {split} split...\")\n",
    "        speaker_dirs = sorted([d for d in split_dir.iterdir() if d.is_dir()])\n",
    "        \n",
    "        # Use 1 worker max to prevent memory spikes from parallel loading\n",
    "        with ThreadPoolExecutor(max_workers=1) as executor:\n",
    "            futures = {executor.submit(process_speaker_dir_efficient, sd): sd.name for sd in speaker_dirs}\n",
    "            for future in tqdm(as_completed(futures), total=len(futures), desc=f\"  {split}\"):\n",
    "                speaker, l1, speaker_prompt_reps = future.result()\n",
    "                \n",
    "                for prompt_id, speaker_data in speaker_prompt_reps.items():\n",
    "                    if prompt_id not in prompt_l1_data:\n",
    "                        prompt_l1_data[prompt_id] = {}\n",
    "                    if l1 not in prompt_l1_data[prompt_id]:\n",
    "                        prompt_l1_data[prompt_id][l1] = {'reps_list': [], 'labels_list': None}\n",
    "                    \n",
    "                    prompt_l1_data[prompt_id][l1]['reps_list'].extend(speaker_data['reps'])\n",
    "                    if prompt_l1_data[prompt_id][l1]['labels_list'] is None:\n",
    "                        prompt_l1_data[prompt_id][l1]['labels_list'] = speaker_data['labels']\n",
    "                \n",
    "                del speaker_prompt_reps\n",
    "        \n",
    "        gc.collect()\n",
    "    \n",
    "    print(f\"Caching to {cache_path}...\")\n",
    "    with open(cache_path, 'wb') as f:\n",
    "        pickle.dump(dict(prompt_l1_data), f)\n",
    "    print(\"✓ Cached\")\n",
    "\n",
    "print(f\"Built L1-aggregated data for {len(prompt_l1_data)} prompts\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Utterance Matching & L1 Averaging"
   ]
  },
  {
